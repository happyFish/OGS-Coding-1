<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>2D Forest Game with House & Cameras</title>
    <style>
        body { margin: 0; overflow: hidden; background: #222; }
        canvas { display: block; background: #3a5c2c; }
        #ui {
            position: absolute; top: 10px; left: 10px; color: #fff; font-family: sans-serif; z-index: 10;
            background: rgba(0,0,0,0.4); padding: 6px 12px; border-radius: 8px;
        }
        #jumpscare {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: #a00;
            color: white;
            font-size: 5vw;
            font-family: sans-serif;
            text-align: center;
            line-height: 100vh;
            z-index: 1000;
        }
    </style>
</head>
<body>
<div id="ui"></div>
<div id="jumpscare">JUMPSCARE!</div>
<canvas id="game" width="900" height="700"></canvas>
<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const ui = document.getElementById('ui');

const WORLD_SIZE = 3000;
const HOUSE = { x: 1400, y: 1400, w: 200, h: 160, door: { x: 1490, y: 1560, w: 20, h: 30 } };
const player = { x: 1500, y: 1550, r: 16, speed: 3, inHouse: false, usingCams: false };
const monster = { x: 2000, y: 1000, r: 28, speed: 1.3 };
const trees = [];
const CAMS = [
    { x: HOUSE.x + 100, y: HOUSE.y - 80, label: "Front Yard" },
    { x: HOUSE.x - 120, y: HOUSE.y + 80, label: "Back Yard" },
    { x: HOUSE.x + 100, y: HOUSE.y + 200, label: "Side Path" },
    { x: HOUSE.x + 300, y: HOUSE.y + 80, label: "Deep Woods" }
];
let camIndex = 0;

// Generate a humongous forest (avoid house area)
for (let i = 0; i < 180; i++) {
    let tx, ty, safe;
    do {
        tx = Math.random() * WORLD_SIZE;
        ty = Math.random() * WORLD_SIZE;
        safe = !(tx > HOUSE.x - 120 && tx < HOUSE.x + HOUSE.w + 120 && ty > HOUSE.y - 120 && ty < HOUSE.y + HOUSE.h + 120);
    } while (!safe);
    trees.push({ x: tx, y: ty, r: 38 + Math.random() * 22 });
}

// Controls
let keys = {};
document.addEventListener('keydown', e => keys[e.key.toLowerCase()] = true);
document.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

// Camera mode
function drawCameraView() {
    // Show a static view of the selected camera
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "#222";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Draw camera label
    ctx.fillStyle = "#fff";
    ctx.font = "32px sans-serif";
    ctx.fillText("CAM: " + CAMS[camIndex].label, 30, 50);

    // Draw monster if near this camera
    let cam = CAMS[camIndex];
    if (Math.hypot(monster.x - cam.x, monster.y - cam.y) < 120) {
        ctx.fillStyle = "#aa0000";
        ctx.beginPath();
        ctx.arc(canvas.width/2, canvas.height/2, 60, 0, Math.PI*2);
        ctx.fill();
        // Eyes
        ctx.fillStyle = "#fff";
        ctx.beginPath();
        ctx.arc(canvas.width/2 - 18, canvas.height/2 - 10, 9, 0, Math.PI*2);
        ctx.arc(canvas.width/2 + 18, canvas.height/2 - 10, 9, 0, Math.PI*2);
        ctx.fill();
    }

    ctx.fillStyle = "#fff";
    ctx.font = "20px sans-serif";
    ctx.fillText("Press 1-4 to switch cameras, E to exit", 30, canvas.height - 30);
}

// Game loop
let gameOver = false;
function loop() {
    if (gameOver) return;

    // Camera mode
    if (player.usingCams) {
        drawCameraView();
        ui.textContent = "CAMERA SYSTEM";
        // Camera controls
        for (let i = 1; i <= 4; i++) {
            if (keys[i]) {
                camIndex = i - 1;
                keys[i] = false;
            }
        }
        if (keys['e']) {
            player.usingCams = false;
            keys['e'] = false;
        }
        requestAnimationFrame(loop);
        return;
    }

    // Move player
    let dx = 0, dy = 0;
    if (keys['w'] || keys['arrowup']) dy -= player.speed;
    if (keys['s'] || keys['arrowdown']) dy += player.speed;
    if (keys['a'] || keys['arrowleft']) dx -= player.speed;
    if (keys['d'] || keys['arrowright']) dx += player.speed;

    // Predict next position
    let nx = player.x + dx, ny = player.y + dy;

    // House collision (walls, except door)
    let inHouseBox = nx > HOUSE.x && nx < HOUSE.x + HOUSE.w && ny > HOUSE.y && ny < HOUSE.y + HOUSE.h;
    let atDoor = nx > HOUSE.door.x && nx < HOUSE.door.x + HOUSE.door.w && ny > HOUSE.door.y && ny < HOUSE.door.y + HOUSE.door.h;

    if (!player.inHouse && inHouseBox && !atDoor) {
        nx = player.x;
        ny = player.y;
    }

    // Tree collision
    for (let t of trees) {
        let dist = Math.hypot(nx - t.x, ny - t.y);
        if (dist < player.r + t.r) {
            nx = player.x;
            ny = player.y;
        }
    }

    player.x = nx;
    player.y = ny;

    // Enter/exit house
    if (!player.inHouse && atDoor && keys['e']) {
        player.inHouse = true;
        keys['e'] = false;
    } else if (player.inHouse && keys['e']) {
        player.inHouse = false;
        keys['e'] = false;
    }

    // Use cameras in house
    if (player.inHouse && keys['c']) {
        player.usingCams = true;
        keys['c'] = false;
    }

    // Monster follows player (if not in house, monster can't enter house)
    if (!player.inHouse) {
        let mdx = player.x - monster.x;
        let mdy = player.y - monster.y;
        let mlen = Math.hypot(mdx, mdy);
        if (mlen > 1) {
            monster.x += (mdx / mlen) * monster.speed;
            monster.y += (mdy / mlen) * monster.speed;
        }
    }

    // Jumpscare if monster touches player outside
    if (!player.inHouse && Math.hypot(player.x - monster.x, player.y - monster.y) < player.r + monster.r - 2) {
        document.getElementById('jumpscare').style.display = 'block';
        gameOver = true;
    }

    // Camera follows player
    let camX = Math.max(0, Math.min(WORLD_SIZE - canvas.width, player.x - canvas.width / 2));
    let camY = Math.max(0, Math.min(WORLD_SIZE - canvas.height, player.y - canvas.height / 2));

    // Draw
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Draw trees
    for (let t of trees) {
        ctx.fillStyle = "#228b22";
        ctx.beginPath();
        ctx.arc(t.x - camX, t.y - camY, t.r, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "#8b5a2b";
        ctx.beginPath();
        ctx.arc(t.x - camX, t.y - camY + t.r / 2, t.r / 3, 0, Math.PI * 2);
        ctx.fill();
    }

    // Draw house
    ctx.fillStyle = "#deb887";
    ctx.fillRect(HOUSE.x - camX, HOUSE.y - camY, HOUSE.w, HOUSE.h);
    // Draw door
    ctx.fillStyle = "#654321";
    ctx.fillRect(HOUSE.door.x - camX, HOUSE.door.y - camY, HOUSE.door.w, HOUSE.door.h);

    // Draw monster (big, red, scary eyes)
    ctx.fillStyle = "#220000";
    ctx.beginPath();
    ctx.arc(monster.x - camX, monster.y - camY, monster.r, 0, Math.PI * 2);
    ctx.fill();
    // Eyes
    ctx.fillStyle = "#ff0000";
    ctx.beginPath();
    ctx.arc(monster.x - camX - 10, monster.y - camY - 8, 5, 0, Math.PI * 2);
    ctx.arc(monster.x - camX + 10, monster.y - camY - 8, 5, 0, Math.PI * 2);
    ctx.fill();

    // Draw player
    ctx.fillStyle = "#3399ff";
    ctx.beginPath();
    ctx.arc(player.x - camX, player.y - camY, player.r, 0, Math.PI * 2);
    ctx.fill();

    // UI
    if (player.inHouse) {
        ui.innerHTML = "In House &nbsp;|&nbsp; Press <b>C</b> for Cameras &nbsp;|&nbsp; <b>E</b> to Exit";
    } else {
        ui.innerHTML = "Explore the Forest &nbsp;|&nbsp; <b>E</b> to Enter House";
    }

    requestAnimationFrame(loop);
}
loop();
</script>
</body>
</html>